<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.farias.rengine</groupId>
		<artifactId>java-game-engine</artifactId>
		<version>1.0.2-SNAPSHOT</version>
	</parent>

	<artifactId>java-game-engine-demos</artifactId>
	<name>Java Game Engine :: Demos</name>

	<properties>
		<!-- Troque com -Dexec.mainClass=com.farias.rengine.examples.SnakeGame -->
		<exec.mainClass>com.farias.rengine.examples.Launcher</exec.mainClass>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.farias.rengine</groupId>
			<artifactId>java-game-engine-core</artifactId>
		</dependency>

		<!-- Natives da plataforma de quem builda (ver profiles no pom raiz). -->
		<dependency>
			<groupId>org.lwjgl</groupId>
			<artifactId>lwjgl</artifactId>
			<classifier>${lwjgl.natives}</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.lwjgl</groupId>
			<artifactId>lwjgl-glfw</artifactId>
			<classifier>${lwjgl.natives}</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.lwjgl</groupId>
			<artifactId>lwjgl-opengl</artifactId>
			<classifier>${lwjgl.natives}</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.lwjgl</groupId>
			<artifactId>lwjgl-stb</artifactId>
			<classifier>${lwjgl.natives}</classifier>
			<scope>runtime</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				Jar fino: so as classes dos demos, com Class-Path apontando para
				lib/. Substitui o uber jar (que embutia os natives de uma unica
				plataforma e portanto so rodava nela).
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>${exec.mainClass}</mainClass>
							<addClasspath>true</addClasspath>
							<classpathPrefix>lib/</classpathPrefix>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-runtime-libs</id>
						<phase>package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/lib</outputDirectory>
							<includeScope>runtime</includeScope>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- mvn -pl java-game-engine-demos exec:exec -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<configuration>
					<executable>${java.home}/bin/java</executable>
					<commandlineArgs>${jvm.platform.args} -cp %classpath ${exec.mainClass}</commandlineArgs>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
